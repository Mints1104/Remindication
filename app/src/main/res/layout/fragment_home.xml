<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Shimmer Layout -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="8dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <View
                    android:layout_width="150dp"
                    android:layout_height="24dp"
                    android:background="@drawable/shimmer_background"/>

                <View
                    android:layout_width="200dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shimmer_background"/>

                <View
                    android:layout_width="180dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/shimmer_background"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- Actual Content Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/next_medication_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="invisible"
        app:cardElevation="8dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next_medication_title"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <TextView
                android:id="@+id/next_medication_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/name_of_next_med"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                />

            <TextView
                android:id="@+id/next_medication_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_of_medication"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="16sp"


                />

            <TextView
                android:id="@+id/medication_instructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Swipe to mark medication as taken or skipped!"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="16sp"


                />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/motivationCover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/tap_to_reveal"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@+id/next_medication_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <ImageView
        android:id="@+id/specialImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/daily_motivational_photo"
        android:visibility="gone"
        android:src="@drawable/cat1"
        app:layout_constraintTop_toBottomOf="@+id/next_medication_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/specialQuoteTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:textSize="30sp"
        app:layout_constraintTop_toBottomOf="@+id/next_medication_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/medications_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/motivationCover"
        app:layout_constraintBottom_toBottomOf="parent"/>



</androidx.constraintlayout.widget.ConstraintLayout>