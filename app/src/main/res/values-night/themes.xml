<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MobileHealthApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Material 3 colors -->
        <item name="colorPrimary">@color/md_theme_inversePrimary</item>
        <item name="colorOnPrimary">@color/md_theme_primary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryFixed</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryFixed</item>

        <item name="colorSecondary">@color/md_theme_secondaryFixed</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondaryFixed</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryFixedDim</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryFixedVariant</item>

        <item name="colorTertiary">@color/md_theme_tertiaryFixed</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiaryFixed</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryFixedDim</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryFixedVariant</item>

        <item name="colorError">@color/md_theme_error_mediumContrast</item>
        <item name="colorOnError">@color/md_theme_onError_mediumContrast</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer_mediumContrast</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer_mediumContrast</item>

        <!-- Surface colors -->
        <item name="android:colorBackground">@color/test</item>
        <item name="colorOnBackground">@color/md_theme_inverseOnSurface</item>
        <item name="colorSurface">@color/md_theme_inverseSurface</item>
        <item name="colorOnSurface">@color/md_theme_inverseOnSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_inverseOnSurface</item>

        <!-- Additional colors -->
        <item name="colorOutline">@color/md_theme_outline_mediumContrast</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/test</item>
        <item name="android:navigationBarColor">@color/test</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Component styles -->
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigation</item>
    </style>

    <!-- Custom component styles -->
    <style name="Widget.App.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">@color/md_theme_surfaceContainerHigh</item>
    </style>

    <style name="Widget.App.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/test</item>
        <item name="itemIconTint">@color/md_theme_inverseOnSurface</item>
        <item name="itemTextColor">@color/md_theme_inverseOnSurface</item>
    </style>
</resources>